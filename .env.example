VAARI_ENV=development
# Required in production (at least 32 characters). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
VAARI_SECRET_KEY=
VAARI_SESSION_HOURS=12
VAARI_LOGIN_RATE_PER_MIN=10
VAARI_LOGIN_LOCKOUT_FAILURES=5
VAARI_LOGIN_LOCKOUT_MINUTES=15
VAARI_UPLOAD_RATE_PER_MIN=30
# Only behind your own reverse proxy that sets X-Forwarded-For
VAARI_TRUST_PROXY=false
# Exact origins allowed to call the API from another site (comma-separated). Empty = same origin only.
VAARI_CORS_ORIGINS=
VAARI_DRIVER_LINK_DAYS=30
VAARI_RECORD_LINK_DAYS=365
# Development only. Ignored (switched off) when VAARI_ENV=production.
VAARI_DEMO_PASSCODE=change-me
VAARI_DB_PATH=data/vaari.sqlite
VAARI_DATA_DIR=data
VAARI_TZ=Asia/Kolkata
VAARI_TODAY=
VAARI_WINDOW_DAYS=20
VAARI_MAX_RADIUS_KM=25
VAARI_ROAD_FACTOR=1.3
VAARI_MAX_PHOTO_MB=8
# Where photos are kept. Only 'local' (under VAARI_DATA_DIR) is built.
VAARI_PHOTO_STORE=local
# Where python tasks.py backup writes. Copy backups off this machine as well.
VAARI_BACKUP_DIR=backups
VAARI_TOO_FAST_MIN_PER_ACRE=25
VAARI_SEED_PHONES=
VAARI_DEMO_PLOT_LAT=30.7333
VAARI_DEMO_PLOT_LON=76.7794
VAARI_CENTRE_LAT=30.7333
VAARI_CENTRE_LON=76.7794
VAARI_CENTRE_NAME=Kisan Seva Kendra Nabha
VAARI_CENTRE_PHONE=9876543210
VAARI_PUBLIC_BASE_URL=
# mock (default, development only) | gemini_demo (DEMO ONLY, images go to Google) | custom (your own endpoint)
VAARI_READER=mock
VAARI_ALLOW_HOSTED_READER=false
VAARI_ALLOW_HOSTED_READER_IN_PRODUCTION=false
VAARI_VISION_PROVIDER=gemini
# Required when the hosted reader is on: a current Gemini vision model name. No default.
VAARI_VISION_MODEL=
GEMINI_API_KEY=
# VAARI_READER=custom: an endpoint on infrastructure the centre controls
VAARI_CUSTOM_READER_URL=
VAARI_CUSTOM_READER_TOKEN=
VAARI_READER_TIMEOUT_S=20
# Send one synthetic image through a remote reader at start-up and show the result in /api/health
VAARI_READER_PROBE=true
